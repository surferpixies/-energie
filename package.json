{
  "name": "energie-ios",
  "version": "3.56.125",
  "private": true,
  "description": "Conteneur Capacitor pour Énergie (iOS et Android)",
  "scripts": {
    "build:ios-web": "node scripts/build-ios-web.mjs",
    "ios:add": "npm run build:ios-web && npx cap add ios",
    "ios:sync": "npm run build:ios-web && npx cap sync ios",
    "ios:open": "npx cap open ios",
    "cnf:import": "node scripts/import-cnf.mjs",
    "cnf:audit": "node scripts/audit-cnf-mapping.mjs",
    "cnf:seed": "node scripts/build-cnf-mapping-seed.mjs",
    "cnf:review": "node scripts/review-cnf-unresolved.mjs",
    "test:cnf-runtime": "node tests/cnf-runtime.test.js",
    "cnf:catalog": "node scripts/build-cnf-catalog.mjs",
    "test:cnf-search": "node tests/cnf-search.test.js",
    "build:android-web": "node scripts/build-android-web.mjs",
    "android:add": "npm run build:android-web && npx cap add android",
    "android:sync": "npm run build:android-web && npx cap sync android",
    "android:open": "npx cap open android",
    "android:assets": "npx @capacitor/assets generate --android --iconBackgroundColor '#eef8e7' --iconBackgroundColorDark '#eef8e7'"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/android": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
